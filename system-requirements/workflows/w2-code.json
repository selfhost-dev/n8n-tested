      ],
      "name": "Transform",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "return $input.all().map(({ json }) => ({ json: { id: json.id, len: json.pad.length, hash: (json.id * 2654435761) % 4294967296 } }));"
      }
    },
    {
      "id": "benchW2Code00001-n3",
      "position": [
        720,
        0
      ],
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const all = $input.all();\nreturn [{ json: { items: all.length, totalLen: all.reduce((s, i) => s + i.json.len, 0) } }];"
      }
